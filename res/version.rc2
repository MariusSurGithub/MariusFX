#include "version.h"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_REVISION,VERSION_BUILD
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_REVISION,VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS (VS_FF_PRERELEASE | VS_FF_DEBUG)
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040004b0"
        BEGIN
            // FiveM's graphics-mod loader (rage-graphics-five/
            // ReShadeFixups.cpp::IsValidGraphicsLibrary) whitelists
            // only ProductName == "ReShade" or "ENBSeries". Anything
            // else is rejected on sight.
            //
            // The "ReShade" branch is gated by extra checks: rejects
            // versions <3.1, ==5.9.0 (heap corruption), and >=5.0
            // (needs a per-machine ReShade5= override line in
            // CitizenFX.ini that literally contains the word
            // "ReShade"). Worse, version <5.9 + nui_useInProcessGpu==
            // true blocks load entirely, and that ConVar defaults to
            // true in nui-core/NUIApp.cpp.
            //
            // The "ENBSeries" branch is far more permissive: the only
            // requirements are ProductVersion >= 0.3.8.7 and a
            // LegalCopyright that does not contain "2019, Boris".
            // Both trivial to satisfy. So we present as ENBSeries to
            // the loader, which makes the install a one-shot drop-in
            // with zero user action and zero "ReShade" string written
            // to any user-visible config file.
            //
            // ProductName is internal-only and never printed in any
            // log; only the explicit FileDescription / CompanyName /
            // OriginalFilename / runtime UI strings are user-facing.
            VALUE "CompanyName", "MariusFX"
            VALUE "FileVersion", VERSION_STRING_FILE
            VALUE "ProductName", "ENBSeries"
            VALUE "ProductVersion", VERSION_STRING_PRODUCT
            VALUE "LegalCopyright", "Copyright Â© MariusFX. All rights reserved."
#ifdef RESHADE_FXC
            VALUE "FileDescription", "MariusFX shader compiler"
#else
    #ifndef _WIN64
            VALUE "FileDescription", "MariusFX post-processing injector for 32-bit"
            VALUE "OriginalFilename", "MariusFX32.dll"
    #else
            VALUE "FileDescription", "MariusFX post-processing injector for 64-bit"
            VALUE "OriginalFilename", "MariusFX64.dll"
    #endif
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x400, 0x4b0
    END
END
