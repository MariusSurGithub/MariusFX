#include "version.h"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_REVISION,VERSION_BUILD
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_REVISION,VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS (VS_FF_PRERELEASE | VS_FF_DEBUG)
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040004b0"
        BEGIN
            // ProductName must stay literally "ReShade" because FiveM's
            // graphics-mod loader (rage-graphics-five/ReShadeFixups.cpp)
            // whitelists only ProductName == "ReShade" or "ENBSeries".
            // Anything else is rejected on sight. The user-facing brand
            // is carried by FileDescription / CompanyName / OriginalFilename
            // and by the runtime UI we ship; ProductName is internal-only
            // and never printed by the engine.
            VALUE "CompanyName", "MariusFX"
            VALUE "FileVersion", VERSION_STRING_FILE
            VALUE "ProductName", "ReShade"
            VALUE "ProductVersion", VERSION_STRING_PRODUCT
            VALUE "LegalCopyright", "Copyright Â© MariusFX. All rights reserved."
#ifdef RESHADE_FXC
            VALUE "FileDescription", "MariusFX shader compiler"
#else
    #ifndef _WIN64
            VALUE "FileDescription", "MariusFX post-processing injector for 32-bit"
            VALUE "OriginalFilename", "MariusFX32.dll"
    #else
            VALUE "FileDescription", "MariusFX post-processing injector for 64-bit"
            VALUE "OriginalFilename", "MariusFX64.dll"
    #endif
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x400, 0x4b0
    END
END
